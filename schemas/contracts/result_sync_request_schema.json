{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/contracts/result_sync_request_schema.json",
  "title": "Atlas-to-Ceres Result Sync Request",
  "description": "Request written by an Atlas stage job for later synchronization by Ceres.",
  "type": "object",
  "required": [
    "request_version",
    "request_created_at",
    "source_site",
    "destination_site",
    "run",
    "promotion",
    "run_bundle"
  ],
  "properties": {
    "request_version": {
      "const": "1.0"
    },
    "request_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_site": {
      "const": "ATLAS"
    },
    "destination_site": {
      "const": "CERES"
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "batch_id",
        "stage",
        "status",
        "ended_at"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "partial",
            "failed",
            "canceled",
            "skipped"
          ]
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "promotion": {
      "type": "object",
      "required": [
        "succeeded",
        "promoted_at"
      ],
      "properties": {
        "succeeded": {
          "type": "boolean"
        },
        "promoted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "succeeded": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "promoted_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "succeeded": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "promoted_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "run_bundle": {
      "$ref": "#/$defs/run_bundle"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "run_bundle": {
      "type": "object",
      "required": [
        "src_endpoint",
        "dst_endpoint",
        "src_path",
        "dst_path",
        "recursive"
      ],
      "properties": {
        "src_endpoint": {
          "type": "string",
          "minLength": 1
        },
        "dst_endpoint": {
          "type": "string",
          "minLength": 1
        },
        "src_path": {
          "$ref": "#/$defs/transfer_path"
        },
        "dst_path": {
          "$ref": "#/$defs/transfer_path"
        },
        "recursive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "transfer_path": {
      "type": "string",
      "pattern": "^/90daydata/.+"
    }
  }
}
