#!/usr/bin/env bash
#SBATCH --job-name={{ stage_name }}_{{ batch_id }}
#SBATCH --account={{ account }}
#SBATCH --partition={{ partition }}
{% if gres %}
#SBATCH --gres={{ gres }}
{% endif %}
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task={{ cpus }}
#SBATCH --mem={{ mem }}
#SBATCH --time={{ time_limit }}
#SBATCH -o {{ log_dir }}/{{ batch_id }}-%j.out
#SBATCH -e {{ log_dir }}/{{ batch_id }}-%j.err

# ── Job-level constants ───────────────────────────────────────────────────────
BATCH_ID="{{ batch_id }}"
LEASE_ID="{{ lease_id }}"
ORCHESTRATOR_ID="{{ orchestrator_id }}"
AGIR_DIR="{{ agir_pipeline_dir }}"
CONFIG_PATH="{{ stage_config }}"
MODEL_PATH="{{ model_path }}"
SPECIES_CATALOG_PATH="{{ species_catalog_path }}"
CPUS={{ cpus }}
DB_PATH="{{ db_path }}"

INPUT_STAGING_DIR="{{ input_staging_dir }}"

OUTPUT_STAGE_RUNS="{{ output_stage_runs }}"
FINAL_DEST="{{ final_dest }}"

{% if result_sync_enabled %}
RESULT_SYNC_OUTBOX="{{ result_sync_outbox }}"
RESULT_SYNC_SRC_ENDPOINT="{{ result_sync_src_endpoint }}"
RESULT_SYNC_DST_ENDPOINT="{{ result_sync_dst_endpoint }}"
RESULT_SYNC_DST_RUN_ROOT="{{ result_sync_dst_run_root }}"
{% endif %}
# Resolved per-batch from season_date_ranges/globus_file_index by
# orchestrator/submit_jobs.py (see resolve_season_for_batch,
# resolve_file_path_with_priority) when this stage's cli_args references
# them — empty for stages/configs that don't, same as MODEL_PATH and
# SPECIES_CATALOG_PATH above.
BBOT_VERSION="{{ bbot_version }}"
SHAPEFILE_PATH="{{ shapefile_path }}"

# ── Logging helpers ───────────────────────────────────────────────────────────
JOB_LOG="{{ log_dir }}/{{ batch_id }}-${SLURM_JOB_ID}.log"

log() {
    echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*" | tee -a "$JOB_LOG"
}
log_section() {
    log "════════════════════════════════════════"
    log "$*"
    log "════════════════════════════════════════"
}
on_exit() {
    local rc=$?
    if [[ $rc -ne 0 ]]; then
        log "[ERROR] Job exited with code $rc"
    fi
    log "Job finished — exit=$rc"
}
trap on_exit EXIT
set -euo pipefail

# ── Environment ───────────────────────────────────────────────────────────────
source "{{ uv_env }}"
cd "$AGIR_DIR"
export PYTHONPATH="$AGIR_DIR${PYTHONPATH:+:$PYTHONPATH}"

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

JOB_STARTED_AT=$(python -c 'from datetime import datetime, timezone; print(datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"))')

finalize_early_failure() {
    local reason="$1"

{% if result_sync_enabled %}
    local failure_run_id
    local failure_bundle
    local register_exit
    local ingest_exit

    failure_run_id=$(python -c 'import uuid; print(uuid.uuid4())')
    failure_bundle="$OUTPUT_STAGE_RUNS/$failure_run_id"

    set +e
    python "$AGIR_DIR/scripts/job/register_result_sync.py" \
        --run-bundle "$failure_bundle" \
        --outbox "$RESULT_SYNC_OUTBOX" \
        --src-endpoint "$RESULT_SYNC_SRC_ENDPOINT" \
        --dst-endpoint "$RESULT_SYNC_DST_ENDPOINT" \
        --dst-run-root "$RESULT_SYNC_DST_RUN_ROOT" \
        --create-failure-bundle \
        --run-id "$failure_run_id" \
        --batch-id "$BATCH_ID" \
        --stage "{{ stage_name }}" \
        --failure-reason "$reason" \
        --started-at "$JOB_STARTED_AT" \
        --job-log "$JOB_LOG"
    register_exit=$?

    python "$AGIR_DIR/scripts/job/ingest_and_release.py" \
        --db "$DB_PATH" \
        --run-report "$failure_bundle/run_report.json" \
        --lease-id "$LEASE_ID" \
        --orchestrator-id "$ORCHESTRATOR_ID" \
        --release-reason "$reason"
    ingest_exit=$?
    set -e

    if [[ "$register_exit" -ne 0 ]]; then
        log "[ERROR] Failed to register early failure bundle: $failure_bundle"
    fi
    if [[ "$ingest_exit" -ne 0 ]]; then
        log "[ERROR] Failed to ingest early failure bundle: $failure_bundle"
    fi
{% else %}
    python "$AGIR_DIR/scripts/job/ingest_and_release.py" \
        --db "$DB_PATH" \
        --lease-id "$LEASE_ID" \
        --orchestrator-id "$ORCHESTRATOR_ID" \
        --release-reason "$reason"
{% endif %}

    exit 1
}

log_section "{{ stage_name }} starting"
log "Batch:   $BATCH_ID"
log "Node:    $(hostname -f)"
log "Job ID:  $SLURM_JOB_ID"

# ── Step 1: Validate staged inputs ────────────────────────────────────────────
log_section "[1/6] Validate staged inputs"
log "Input staging dir: $INPUT_STAGING_DIR"

set +e
# Not -maxdepth 1: some stages' input_staging_dir is a batch root containing
# multiple subdirs (e.g. det_to_world's images/ + detections/) rather than a
# single leaf directory of files, so this must look at the whole tree.
FILE_COUNT=$(find "$INPUT_STAGING_DIR" -type f 2>/dev/null | wc -l)
set -e

if [[ "$FILE_COUNT" -eq 0 ]]; then
    log "[ERROR] No input files found at $INPUT_STAGING_DIR"
    finalize_early_failure "no_input_files"
fi
log "Staged files available: $FILE_COUNT"

# ── Step 2: Copy inputs to TMPDIR ─────────────────────────────────────────────
log_section "[2/6] Copy inputs to TMPDIR"
TMPINPUT="$TMPDIR/input"
TMPOUTPUT="$TMPDIR/output"
mkdir -p "$TMPINPUT" "$TMPOUTPUT"

{% if stage_name == "det_to_world" %}
# det_to_world only: images/ can hold every image in the batch rather than
# just the sampled subset staged_inputs normally fetches for visualization —
# e.g. when it was already resident at the destination when staged
# (already_satisfied, see orchestrator/input_staging_planner.py) from an
# earlier stage that promoted the full set. Cap what actually lands in
# TMPDIR at IMAGE_SAMPLE_SIZE either way, so a job never copies a whole
# batch of images it has no use for. Gated on stage_name (not a generic
# "does images/ exist" check) since no other stage's input_staging_dir
# layout has a nested images/ subdir to sample from.
IMAGE_SAMPLE_SIZE={{ image_sample_size }}
mkdir -p "$TMPINPUT/images"
IMAGE_COUNT=$(find "$INPUT_STAGING_DIR/images" -type f 2>/dev/null | wc -l)
if [[ "$IMAGE_COUNT" -gt "$IMAGE_SAMPLE_SIZE" ]]; then
    log "images/ has $IMAGE_COUNT file(s) staged, above sample size $IMAGE_SAMPLE_SIZE — copying a random sample"
    find "$INPUT_STAGING_DIR/images" -type f -print0 \
        | shuf -z -n "$IMAGE_SAMPLE_SIZE" \
        | xargs -0 -I{} cp {} "$TMPINPUT/images/"
else
    log "images/ has $IMAGE_COUNT file(s) staged, at or under sample size $IMAGE_SAMPLE_SIZE — copying all"
    rsync -a "$INPUT_STAGING_DIR/images/." "$TMPINPUT/images/"
fi
rsync -av --exclude images "$INPUT_STAGING_DIR"/. "$TMPINPUT"/
{% else %}
rsync -av "$INPUT_STAGING_DIR"/. "$TMPINPUT"/
{% endif %}

COPIED_COUNT=$(find "$TMPINPUT" -type f 2>/dev/null | wc -l)
log "Copied $COPIED_COUNT file(s) to $TMPINPUT"

# ── Step 3: Run stage CLI ─────────────────────────────────────────────────────
log_section "[3/6] Running {{ stage_name }}"

set +e
python -m {{ cli_module }} \
    {{ cli_args }}
STAGE_EXIT=$?
set -e
log "Stage exit code: $STAGE_EXIT"

# Resolve run dir from output
RUN_DIR=$(ls -td "$TMPOUTPUT/{{ output_subdir }}"/*/  2>/dev/null | head -1)
RUN_ID=$(basename "$RUN_DIR" 2>/dev/null || echo "unknown")

if [[ -z "$RUN_DIR" || ! -d "$RUN_DIR" ]]; then
    log "[ERROR] Could not resolve run directory under $TMPOUTPUT/{{ output_subdir }}"
    finalize_early_failure "no_run_dir"
fi
log "Run dir: $RUN_DIR"
log "Run ID:  $RUN_ID"

# ── Step 4: Visualize sample ──────────────────────────────────────────────────
log_section "[4/6] Generating visualization sample"
VIZ_DIR="$TMPDIR/visualizations"
mkdir -p "$VIZ_DIR"
VIZ_EXIT=0

if [[ "$STAGE_EXIT" -le 1 ]]; then
    set +e
    {{ viz_cmd }}
    VIZ_EXIT=$?
    set -e
    if [[ $VIZ_EXIT -eq 0 ]]; then
        log "Visualization sample written to $VIZ_DIR"
    else
        log "[WARN] Visualization step exited $VIZ_EXIT — continuing"
        VIZ_EXIT=0   # non-fatal
    fi
else
    log "Skipping visualization — stage_exit=$STAGE_EXIT"
fi

# ── Step 5: Promote outputs and ingest ────────────────────────────────────────
log_section "[5/6] Promoting outputs"
PROMOTE_EXIT=0
PROMOTION_SUCCEEDED=0
PROMOTED_AT=""
VIZ_DEST="{{ viz_dest }}"

if [[ "$STAGE_EXIT" -le 1 ]]; then
    mkdir -p "$FINAL_DEST"
    set +e
    python "$AGIR_DIR/scripts/job/promote.py" \
        --run-dir "$RUN_DIR" \
        --dest "$FINAL_DEST"
    PROMOTE_EXIT=$?
    set -e
    log "Promote exit: $PROMOTE_EXIT"
    if [[ "$PROMOTE_EXIT" -eq 0 ]]; then
        PROMOTION_SUCCEEDED=1
        PROMOTED_AT=$(python -c 'from datetime import datetime, timezone; print(datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"))')
    fi

    # Promote visualization sample (non-fatal)
    if [[ -d "$VIZ_DIR" && "$(ls -A "$VIZ_DIR" 2>/dev/null)" ]]; then
        mkdir -p "$VIZ_DEST"
        VIZ_ZIP="$TMPDIR/{{ stage_name }}_sample_${BATCH_ID}.zip"
        zip -j "$VIZ_ZIP" "$VIZ_DIR"/*
        cp "$VIZ_ZIP" "$VIZ_DEST/"
        log "Visualization sample zipped and promoted to $VIZ_DEST"
    else
        log "No visualization files to promote"
    fi
else
    log "Skipping promotion — stage_exit=$STAGE_EXIT"
fi

log_section "[6/6] Copy artifacts + ingest"
ARTIFACT_DEST="$OUTPUT_STAGE_RUNS/$RUN_ID"
mkdir -p "$ARTIFACT_DEST"
rsync -a "$RUN_DIR/" "$ARTIFACT_DEST/"
log "Artifacts saved to $ARTIFACT_DEST"

REGISTER_EXIT=0
{% if result_sync_enabled %}
    REGISTER_ARGS=(
        --run-bundle "$ARTIFACT_DEST"
        --outbox "$RESULT_SYNC_OUTBOX"
        --src-endpoint "$RESULT_SYNC_SRC_ENDPOINT"
        --dst-endpoint "$RESULT_SYNC_DST_ENDPOINT"
        --dst-run-root "$RESULT_SYNC_DST_RUN_ROOT"
    )
    if [[ "$PROMOTION_SUCCEEDED" == "1" ]]; then
        REGISTER_ARGS+=(
            --promotion-succeeded
            --promoted-at "$PROMOTED_AT"
        )
    fi

    set +e
    python "$AGIR_DIR/scripts/job/register_result_sync.py" "${REGISTER_ARGS[@]}"
    REGISTER_EXIT=$?
    set -e
    if [[ "$REGISTER_EXIT" -ne 0 ]]; then
        log "[ERROR] Result-sync registration failed for $ARTIFACT_DEST"
    fi
{% endif %}

RELEASE_REASON="stage_exit_${STAGE_EXIT}_promote_exit_${PROMOTE_EXIT}"
python "$AGIR_DIR/scripts/job/ingest_and_release.py" \
    --db "$DB_PATH" \
    --run-report "$ARTIFACT_DEST/run_report.json" \
    --lease-id "$LEASE_ID" \
    --orchestrator-id "$ORCHESTRATOR_ID" \
    --release-reason "$RELEASE_REASON"

if [[ "$REGISTER_EXIT" -ne 0 ]]; then
    exit "$REGISTER_EXIT"
fi

log "DONE — stage={{ stage_name }} batch=$BATCH_ID stage_exit=$STAGE_EXIT promote_exit=$PROMOTE_EXIT"
