        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Inventory / control plane\n    LTS[JUNO LTS&lt;br/&gt;Authoritative storage] --&gt;|Globus index scan| INDEX[scripts/admin/globus_index.py]\n    INDEX --&gt; DB[(SQLite control-plane DB)]\n\n    DB --&gt; INV[Inventory tables&lt;br/&gt;globus_file_index&lt;br/&gt;batch_inventory_summary]\n    DB --&gt; READY[Readiness views&lt;br/&gt;v_batches_needing_raw_to_jpg&lt;br/&gt;v_batches_needing_jpg_to_det]\n    DB --&gt; LEASES[stage_leases]\n    DB --&gt; RUNS[stage_runs]\n\n    %% Input staging\n    READY --&gt; PLANNER[orchestrator/input_staging_planner.py&lt;br/&gt;map ready batches to staging requests]\n    PLANNER --&gt; REQUESTS[StagingRequest list]\n    REQUESTS --&gt; TRANSFER[orchestrator/globus_transfer.py&lt;br/&gt;submit input transfers]\n    TRANSFER --&gt; STAGED[90daydata&lt;br/&gt;persistent staged inputs]\n\n    %% Optional transfer tracking\n    TRANSFER -. optional status .-&gt; STAGED_INPUTS[staged_inputs&lt;br/&gt;optional SQLite table]\n    STAGED_INPUTS -. read status .-&gt; DB\n\n    %% Job submission\n    STAGED --&gt; SUBMIT[scripts/job/submit.py]\n    READY --&gt; SUBMIT\n    SUBMIT --&gt;|claim lease| LEASES\n    SUBMIT --&gt; RENDER[orchestrator/submit_jobs.py&lt;br/&gt;render job script]\n    RENDER --&gt; TEMPLATE[orchestrator/templates/job.sh.j2]\n    TEMPLATE --&gt; SBATCH[sbatch]\n\n    %% Compute job lifecycle\n    SBATCH --&gt; JOB[SLURM compute job]\n    JOB --&gt; RSYNC_IN[rsync&lt;br/&gt;90daydata to TMPDIR/input]\n    RSYNC_IN --&gt; TMP[TMPDIR&lt;br/&gt;ephemeral job scratch]\n    TMP --&gt; STAGECLI[Run stage CLI&lt;br/&gt;raw_to_jpg or jpg_to_det]\n    STAGECLI --&gt; PROMOTE[Verify and promote outputs]\n    PROMOTE --&gt; OUT[90daydata&lt;br/&gt;stage outputs]\n    PROMOTE --&gt; RUN_DIR[90daydata/stage_runs/run_id]\n\n    %% Completion\n    RUN_DIR --&gt; INGEST[scripts/job/ingest_and_release.py]\n    INGEST --&gt;|insert/update| RUNS\n    INGEST --&gt;|release lease| LEASES\n    RUNS --&gt; READY\n\n    %% Future output promotion\n    OUT -. future Globus promotion .-&gt; LTS&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="08ztl9xdkokJElmEUcUY-224">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
